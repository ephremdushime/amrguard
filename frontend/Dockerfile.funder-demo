FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html ./index.html
COPY src ./src
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
ARG VITE_FUNDER_DEMO=1
ENV VITE_FUNDER_DEMO=${VITE_FUNDER_DEMO}
RUN npm run build

FROM nginx:1.27-alpine
RUN apk add --no-cache apache2-utils
COPY nginx.funder-demo.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint-demo.sh /docker-entrypoint-demo.sh
RUN chmod 0555 /docker-entrypoint-demo.sh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["/docker-entrypoint-demo.sh"]
CMD ["nginx", "-g", "daemon off;"]
