# Copy to a private .env.sandbox file on the sandbox host. Never commit that file.
APP_ENV=sandbox
POSTGRES_DB=amrguard_sandbox
POSTGRES_USER=amrguard_sandbox
POSTGRES_PASSWORD=CHANGE_ME_USE_A_UNIQUE_RANDOM_SECRET
INTEGRATION_API_KEY=CHANGE_ME_USE_A_DIFFERENT_UNIQUE_RANDOM_SECRET
ALLOWED_ORIGINS=https://sandbox.example.org
WEB_PORT=8081
