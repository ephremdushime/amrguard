# Copy to .env and replace every CHANGE_ME value before deploying.
APP_ENV=production
POSTGRES_DB=amrguard
POSTGRES_USER=amrguard
POSTGRES_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
INTEGRATION_API_KEY=CHANGE_ME_USE_A_DIFFERENT_OPENSSL_RAND_HEX_32
CREDENTIAL_HMAC_SECRET=CHANGE_ME_USE_A_THIRD_OPENSSL_RAND_HEX_32
# Human auth defaults to institutional OIDC in production; local auth is disabled by default.
AUTH_MODE=oidc
ALLOW_LOCAL_AUTH=false
OIDC_ISSUER=https://idp.example.org/realms/amrguard
OIDC_AUDIENCE=amrguard-api
OIDC_JWKS_URL=https://idp.example.org/realms/amrguard/protocol/openid-connect/certs
# Conditional cross-facility dispensing defaults to disabled until networks/permissions are provisioned.
CROSS_FACILITY_DISPENSING_ENABLED=false
ALLOWED_ORIGINS=https://amrguard.example.org
WEB_PORT=8080
